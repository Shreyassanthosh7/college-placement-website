rules_version = '2';

// ============================================================================
// PHASE 10 — hardened rules. Builds on the working draft from Phases 5-9
// (same collections, same public-read / admin-write access model) by
// adding field-level validation on every write: an admin account being
// compromised, a client-side bug, or a typo in the admin UI should not be
// able to write malformed data that the public site then has to handle
// gracefully everywhere. isAdmin() alone answers "is this allowed to
// write at all?" — the validation functions below answer "is this
// actually a well-formed <collection> document?"
//
// Note: `gallery` and Firebase Storage were removed at the developer's
// request (Storage requires the paid Blaze plan for the modern default
// bucket, and they don't want to pay for it). This file covers companies,
// placementDrives, announcements, private placements/archive, settings,
// and users.
//
// What this does NOT do (documented honestly rather than pretended):
// - Rate limiting. Firestore Security Rules have no request-rate concept
//   — that requires Firebase App Check (bot/abuse protection) and/or
//   Cloud Functions with their own quota logic, neither of which is set
//   up in this project. If abuse becomes a real concern, that's the
//   next thing to add, not a rules change.
// - Schema migrations. If a field is renamed later, old documents won't
//   retroactively satisfy a new validation function — rules validate
//   writes going forward, not data already at rest.
//
// HOW TO APPLY: Firebase Console → Firestore Database → Rules → paste this
// entire file → Publish.
// ============================================================================

service cloud.firestore {
  match /databases/{database}/documents {

    // ---- Shared helpers ----

    // True only if the signed-in user has a users/{uid} doc with
    // role == "ADMIN". This is the ONLY thing that grants write access —
    // being signed in to Firebase Auth is not enough on its own, matching
    // the same rule the frontend's AuthContext enforces client-side.
    function isAdmin() {
      return request.auth != null &&
        exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'ADMIN';
    }

    // A non-empty string, optionally capped at a max length — every
    // "required text field" check below is built on this one primitive.
    function isNonEmptyString(value, maxLen) {
      return value is string && value.size() > 0 && value.size() <= maxLen;
    }

    // ---- users ----
    // A signed-in user may read only their own profile document (needed so
    // AuthContext can check its own role). No one may write to this
    // collection from the client — admin user records are created manually
    // in Firebase Console (see README "Creating Your First Admin"), never
    // through the app itself. This is intentionally the strictest rule in
    // the file: role escalation via a client write would defeat every
    // isAdmin() check above.
    match /users/{userId} {
      allow read: if request.auth != null && request.auth.uid == userId;
      allow write: if false;
    }

    // ---- companies ----
    function isValidCompany(data) {
      return isNonEmptyString(data.name, 200) &&
        isNonEmptyString(data.role, 200) &&
        isNonEmptyString(data.package, 100) &&
        isNonEmptyString(data.location, 200) &&
        data.status in ['draft', 'active', 'upcoming', 'closed'] &&
        (!('googleFormUrl' in data) || data.googleFormUrl is string);
    }

    // Public (unauthenticated) visitors may only read companies whose
    // status is active, upcoming, or closed — never draft. Admins may read
    // and write every status without restriction, but every write must
    // still be a well-formed company document.
    match /companies/{companyId} {
      allow read: if resource.data.status in ['active', 'upcoming', 'closed'] || isAdmin();
      allow create, update: if isAdmin() && isValidCompany(request.resource.data);
      allow delete: if isAdmin();
    }

    // ---- placementDrives ----
    function isValidDrive(data) {
      return isNonEmptyString(data.companyName, 200) &&
        isNonEmptyString(data.role, 200) &&
        isNonEmptyString(data.date, 30) &&
        isNonEmptyString(data.venue, 300) &&
        data.status in ['draft', 'upcoming', 'completed'];
    }

    function isValidPlacement(data) {
      return isNonEmptyString(data.studentName, 200) &&
        isNonEmptyString(data.employer, 200) &&
        isNonEmptyString(data.role, 200) &&
        (data.graduationYear is int || data.graduationYear is float) &&
        data.graduationYear >= 1950 && data.graduationYear <= 2100;
    }

    function isValidArchiveRecord(data) {
      return data.keys().hasOnly(['entityType', 'originalId', 'label', 'record', 'archivedAt']) &&
        data.entityType in ['company', 'drive', 'announcement', 'team', 'placement'] &&
        isNonEmptyString(data.originalId, 200) &&
        isNonEmptyString(data.label, 300) &&
        data.record is map &&
        data.archivedAt is timestamp;
    }

    // Same shape as companies: public visitors see upcoming/completed
    // drives only, never draft. Admins have full CRUD, validated.
    match /placementDrives/{driveId} {
      allow read: if resource.data.status in ['upcoming', 'completed'] || isAdmin();
      allow create, update: if isAdmin() && isValidDrive(request.resource.data);
      allow delete: if isAdmin();
    }

    // Placement records can contain student names and employer details, so
    // they are strictly admin-only. The public homepage receives only the
    // aggregate count stored in settings/general.studentsPlaced.
    match /placements/{placementId} {
      allow read: if isAdmin();
      allow create, update: if isAdmin() && isValidPlacement(request.resource.data);
      allow delete: if isAdmin();
    }

    // ---- announcements ----
    function isValidAnnouncement(data) {
      return isNonEmptyString(data.title, 300) &&
        isNonEmptyString(data.content, 5000) &&
        isNonEmptyString(data.publishedAt, 30) &&
        data.status in ['draft', 'published'];
    }

    // Public visitors see only published announcements — never draft.
    // Admins have full CRUD, validated.
    match /announcements/{announcementId} {
      allow read: if resource.data.status == 'published' || isAdmin();
      allow create, update: if isAdmin() && isValidAnnouncement(request.resource.data);
      allow delete: if isAdmin();
    }

    // ---- gallery ----
    // REMOVED by request — this project doesn't use Firebase Storage (it
    // requires the paid Blaze plan for the modern default bucket), and
    // there's no image-upload gallery feature anymore. If a `gallery`
    // collection somehow exists from earlier testing, it's now fully
    // denied (no rule below matches it, and there's no catch-all allow).

    // ---- settings ----
    // A single public document (settings/general) with site-wide info —
    // always public to read (it's the college's name, contact info, etc.,
    // not sensitive), admin-only to write. `create` is included alongside
    // `update` because the very first save from a brand-new project has no
    // existing document yet (see settingsService.js's upsert behavior).
    // No field validation here deliberately — Settings has many optional
    // fields (social links, secondary address, etc.) that legitimately
    // vary by what the admin has filled in, so a strict schema would
    // fight the form rather than protect it.
    match /settings/{docId} {
      allow read: if true;
      allow create, update: if isAdmin();
      allow delete: if false;
    }

    // Archive snapshots are private admin data. Creation and removal of the
    // source item happen atomically in a transaction; restore transactions
    // recreate the source and remove its snapshot in the same commit.
    match /archive/{archiveId} {
      allow read: if isAdmin();
      allow create: if isAdmin() && isValidArchiveRecord(request.resource.data);
      allow update: if false;
      allow delete: if isAdmin();
    }

    // Every rule this project needs is now defined above — nothing left to
    // deny-by-default for, other than genuinely unrecognized paths.
  }
}
