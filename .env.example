# Firebase Web App config — get these from:
# Firebase Console → Project Settings → General → "Your apps" → Web app (</>)
# These are safe to expose in frontend code (not secrets); Firestore
# Security Rules are what actually protect your data.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
# Optional — this app doesn't use Firebase Storage (it requires the paid
# Blaze plan for the modern default bucket), so this value isn't required.
# Safe to leave blank or fill in anyway if you have it.
VITE_FIREBASE_STORAGE_BUCKET=
# Optional — only present if Google Analytics was enabled for the Firebase project
VITE_FIREBASE_MEASUREMENT_ID=
